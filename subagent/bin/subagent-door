#!/bin/sh
# subagent-door '<args JSON>' [workflow run flags...]
#
# The door by plugin name: finds the plugin directory and eidolon, then execs
#   eidolon workflow run <plugin dir> door --args '<args JSON>'
# The line back and the exit code are eidolon's; anything after the JSON goes to
# `workflow run` (`--yolo`). POSIX sh.
#
# eidolon is $EIDOLON_BIN if set (and then only that), else `eidolon` on PATH, else
# $HOME/.local/bin/eidolon, each only if it is an executable that answers `--version`.

if [ $# -lt 1 ]; then
  echo "usage: subagent-door '{\"tool\":\"schema\"}'   (the door's args JSON)" >&2
  exit 64
fi
args=$1
shift

dir=${XDG_CONFIG_HOME:-$HOME/.config}/eidolon/plugins/subagent
if [ ! -f "$dir/plugin.rn" ]; then
  echo "subagent-door: no subagent plugin at $dir (eidolon plugins install ... subagent)" >&2
  exit 66
fi

eid=
eid_ok() { [ -f "$1" ] && [ -x "$1" ] && "$1" --version >/dev/null 2>&1; }
if [ -n "${EIDOLON_BIN:-}" ]; then
  if eid_ok "$EIDOLON_BIN"; then eid=$EIDOLON_BIN; fi
else
  onpath=$(command -v eidolon 2>/dev/null)
  if [ -n "$onpath" ] && eid_ok "$onpath"; then
    eid=$onpath
  elif eid_ok "$HOME/.local/bin/eidolon"; then
    eid=$HOME/.local/bin/eidolon
  fi
fi
if [ -z "$eid" ]; then
  if [ -n "${EIDOLON_BIN:-}" ]; then
    echo "subagent-door: EIDOLON_BIN is set to $EIDOLON_BIN, which is not an executable that runs. Fix it or unset it." >&2
  else
    echo "subagent-door: cannot find a working eidolon binary: not on PATH (${onpath:-absent}) and $HOME/.local/bin/eidolon does not run. Set EIDOLON_BIN to the full path." >&2
  fi
  exit 127
fi

exec "$eid" workflow run "$dir" door --args "$args" "$@"
