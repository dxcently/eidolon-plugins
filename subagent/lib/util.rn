// Helpers for the workflows. Upstream compiles `lib/` in front of a workflow only, so
// tool files carry their own copies.

fn fatal(msg) {
    #{ content: msg, is_error: true }
}

fn money(n) {
    "$" + `${n}`
}

// JSON null is the unit value, which has no text form of its own.
fn text(value) {
    match value {
        Some(v) => {
            if json::to_string(v).unwrap_or("null") == "null" {
                ""
            } else {
                `${v}`
            }
        }
        None => "",
    }
}

fn as_number(v) {
    if json::to_string(v).unwrap_or("null") == "null" {
        return None;
    }
    match `${v}`.parse::<f64>() {
        Ok(n) => Some(n),
        Err(_) => None,
    }
}

fn number(s) {
    match s.parse::<f64>() {
        Ok(n) => n,
        Err(_) => 0.0,
    }
}

fn opt_int(v, dflt) {
    match v {
        Some(x) => match `${x}`.parse::<i64>() {
            Ok(n) => n,
            Err(_) => dflt,
        },
        None => dflt,
    }
}

fn clamp(n, lo, hi) {
    if n < lo {
        lo
    } else if n > hi {
        hi
    } else {
        n
    }
}
