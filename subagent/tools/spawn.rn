// `subagent_spawn`: a child `eidolon run` in the background, handed the brief in
// ../brief.md. The child reports to this session once with `send` and stops;
// nothing here waits for it. The state directory this writes — the brief it was
// given and the facts about it — is what the other four tools of this extension
// read: `subagent_list`, `subagent_trace`, `subagent_steer`, `subagent_cancel`.
//
// Every tool file is compiled on its own, so this one carries its manifest, its
// call, its brief and its helpers whole, and shares nothing with the others.

// Role -> model, for the `role` argument. Empty by default, and that is a
// working default: with no rows only `model` names a model, and every role is
// refused. Add rows in the shape this comment shows, and nothing else changes:
//
//     #{ "quick": "ollama:glm-5.3-flash", "deep": "ollama:deepseek-v4-pro" }
//
// A role is a name *this file* chooses — nothing else in eidolon reads it, and
// the child only ever sees the model that came out of it.
const TIERS = #{};

pub fn manifest() {
    #{
        name: "subagent_spawn",
        description: "Start a child eidolon session in the background with a brief, and return at once with its id, pid and log path. The child is one bounded task: when it is done, or out of time, it messages *this* session with `send` -- a direct message wakes an idle parent, which is the report arriving -- and then stops. Follow it from here with `subagent_list`, `subagent_trace` and `subagent_steer`, and stop it with `subagent_cancel`. Its journal is the record to pick it up again with `eidolon resume <journal>`, and the path is in the child's log.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "task": #{
                    "type": "string",
                    "description": "What the child should do, in your words. It runs in this session's working directory.",
                },
                "role": #{
                    "type": "string",
                    "description": "A name from this file's TIERS table, which resolves to a model. `model` wins over it. A role the table does not name is refused, and the refusal lists the ones it does.",
                },
                "model": #{
                    "type": "string",
                    "description": "Model for the child, passed as `--model`. Wins over `role`. Leave both out and the child runs the model the config defaults to -- the harness's default, not this session's own model.",
                },
                "deadline_min": #{
                    "type": "integer",
                    "description": "Minutes the child has before it is stopped by a signal to its own process group, and reports what it has. Default 15, clamped to 1..120.",
                },
                "yolo": #{
                    "type": "boolean",
                    "description": "Pass `--yolo` to the child: answer every question the gate raises with yes. Default false -- and without it the child stalls on its first flagged tool call (bash, write), because nobody is at its end to answer and nothing can be. Set it for any child meant to act.",
                },
            },
            "required": ["task"],
        },
    }
}

pub async fn call(input) {
    // A child reports to whoever is registered among its peers, so this session
    // has to be: the roster's first line is "You are `<id>`." and the id is
    // between its backticks. A session that is not in the swarm cannot be sent
    // to, and a child of it could never report.
    let roster = eidolon::peers().await?;
    let parent = parent_id(roster);
    if parent == "" {
        return Err("`peers` named no session id: this session is not registered among its peers (swarm disabled in config.toml?), so a child would have nobody to report to");
    }

    // A subagent may not spawn a subagent. The guard is the same line the
    // child's own command runs; asking it here first means a nested call is
    // refused with a reason, rather than answered with a pid whose whole log is
    // one refusal line nobody has read yet.
    let guard = eidolon::shell(GUARD, Some(10)).await?;
    if guard.contains("[exit code 3]") {
        return Err(REFUSED);
    }

    let minutes = deadline_min(input.get("deadline_min"));
    let role = text_of(input.get("role"));
    let model = text_of(input.get("model"));
    if model == "" && role != "" {
        match TIERS.get(`${role}`) {
            Some(m) => model = `${m}`,
            None => {
                let msg = `unknown role '${role}': this file's TIERS names ${known_roles()} -- pass one of those, or pass a model`;
                return Err(msg);
            }
        }
    }
    let yolo = match input.get("yolo") {
        Some(v) => v == true,
        None => false,
    };

    // The id and the start time, from the shell: a second-resolution stamp and
    // two bytes of /dev/urandom, so two spawns in the same second differ and a
    // directory listing sorts by when it was made. One command, one line back.
    let stamp = eidolon::shell(ID_CMD, Some(10)).await?;
    let id = "";
    let started = "";
    match stamp.split_once(' ') {
        Some(pair) => {
            id = pair.0;
            started = pair.1;
        }
        None => {}
    }
    if !id.starts_with("sa-") {
        let msg = `the shell did not hand back a subagent id (${stamp})`;
        return Err(msg);
    }

    let text = brief(id, parent, input.task, minutes);
    let flags = "";
    if model != "" {
        flags += `--model ${quote(model)} `;
    }
    if yolo {
        flags += "--yolo ";
    }
    let child = CHILD_SH
        .replace("{seconds}", `${minutes * 60}`)
        .replace("{flags}", flags)
        .replace("{brief}", quote(text));

    let started_at = eidolon::shell_background(child).await?;
    let pid = field(started_at, "pid");
    let log = field(started_at, "log");
    let status = path_of(field(started_at, "status"));
    if pid == "" || log == "" {
        let msg = `the child started without reporting a pid and a log, so there is nothing to record: ${started_at}`;
        return Err(msg);
    }

    let state = WRITE_SH
        .replace("{id}", quote(id))
        .replace("{lines}", meta_lines(id, parent, role, model, pid, log, status, started, minutes))
        .replace("{brief}", quote(text));
    let written = eidolon::shell(state, Some(30)).await?;
    if written.contains("[exit code") || written.contains("--- stderr ---") {
        let msg = `the child is running, but its state directory could not be written: ${written}`;
        return Err(msg);
    }

    let shown = "(the config default)";
    if model != "" {
        shown = model;
    }
    // The three facts the caller needs are named first: an id for the other
    // four tools, a pid for `kill`, and the log to read or tail.
    let report = `subagent ${id}
pid: ${pid}
log: ${log}
status: ${status} (written when the child finishes)
model: ${shown}, deadline ${minutes} min
`;
    Ok(report)
}

// Everything below is the brief, the two command lines, and the helpers: the
// parent's own id in the roster, the deadline, the state files, and one shell
// word. Upstream eidolon compiles each tool file on its own, and a tool file is
// meant to be handed over whole.

// The guard, as the child's command line runs it (`$EIDOLON_SUBAGENT` is set by
// the spawn that made this session a subagent) and as `subagent_spawn` asks it
// before starting anything.
const GUARD = "[ -n \"$EIDOLON_SUBAGENT\" ] && { echo \"refused: a subagent may not spawn subagents\" >&2; exit 3; }";
const REFUSED = "refused: a subagent may not spawn subagents";

// The child, as the one command line `shell_background` takes — it runs it
// under `bash -c`, in this session's working directory. Everything in it is
// POSIX sh, because this extension is meant for any Unix eidolon runs on:
//
//   * the guard first, so a child of a child is refused at its first line;
//   * EIDOLON_SUBAGENT in the environment, which is what that guard reads;
//   * the deadline as a `sleep` in a backgrounded subshell that then signals
//     its own process group. `shell_background` starts the command under
//     `setsid`, so the command's pid leads a group holding the child's whole
//     tree and nothing else, and `kill -TERM 0` reaches `eidolon run` and
//     everything under it. There is no `timeout` here on purpose: it is GNU
//     coreutils, and absent on macOS;
//   * `kill $!` when the child finishes first, so the sleeping subshell does
//     not outlive it by a whole deadline — and the trap inside it takes the
//     `sleep` too, because `$!` is the subshell and the `sleep` is its child:
//     killing the subshell alone leaves a stray `sleep` in the child's process
//     group until the deadline, which is a process nobody asked for and a group
//     that answers `kill -0 -<pid>` "alive" about a child that has gone.
//
// The pid that comes back is the shell's, which is the group leader: that is
// what `subagent_cancel` signals, and the child is what dies with it.
const CHILD_SH = "[ -n \"$EIDOLON_SUBAGENT\" ] && { echo \"refused: a subagent may not spawn subagents\" >&2; exit 3; }
export EIDOLON_SUBAGENT=1
( trap 'kill \"$sleeper\" 2>/dev/null; exit 0' TERM
  sleep {seconds} &
  sleeper=$!
  wait \"$sleeper\"
  echo \"deadline reached\" >&2
  kill -TERM 0 ) &
eidolon run {flags}{brief}
code=$?
kill $! 2>/dev/null
exit $code
";

// The two files that make a spawn findable later: the brief the child was
// handed, and the facts the other four tools read. `printf` gets one quoted
// word per line, so nothing in a task, a role or a model can become syntax.
const WRITE_SH = "root=${XDG_STATE_HOME:-$HOME/.local/state}/eidolon/subagents
dir=$root/{id}
mkdir -p \"$dir\" || exit 1
printf '%s\n' {lines} > \"$dir/meta\" || exit 1
printf '%s' {brief} > \"$dir/brief\" || exit 1
printf '%s\n' \"$dir/meta\" \"$dir/brief\"
";

// The id and the start, from the clock and /dev/urandom, with no trailing
// newline so the line back is exactly the two words.
const ID_CMD = "s=$(date +%s); printf 'sa-%s-%s %s' \"$s\" \"$(od -An -N2 -tx1 /dev/urandom | tr -d ' \\n')\" \"$s\"";

// The block from ../brief.md, placeholder and all: {id}, {parent}, {task} and
// {deadline} are the four the tool fills, and {cwd} becomes words rather than a
// path because the child inherits the parent's directory. The deadline is not
// the child's good manners either — it is the signal in CHILD_SH above. Keep
// this and ../brief.md in step: the file is the brief's readable copy, not a
// second source of truth.
const BRIEF = "You are subagent {id}.

Your parent is {parent}; your tools run in {cwd}; you have {deadline} minutes,
after which you are stopped and report what you have.

{task}

When the task is done — or the deadline arrives — do exactly three things and
nothing else:

1. Send your parent one message, to {parent}, with `send` — a direct message
   wakes an idle parent by default, and that is the point: the report is the
   thing the parent is waiting on:
   * state: done, or stopped-early and why
   * what you changed, by path, and whether it is committed
   * the checks you ran, with their counts, and what you could NOT check
   * your journal path, so the parent can resume you (`eidolon resume <path>`,
     optionally `--at <record id>`), and whether the context should be
     compacted first (`compact` in a session; the journal records it)
2. Say nothing else to anyone. No channel messages, no courtesy replies.
3. Stop. If you are a one-shot run you simply end; if you are a chat, end your
   turn and leave the journal as it is — it is the record the parent resumes.

Your journal is the only thing that has to be right. Do not summarise it away,
do not compact for a finished task, and do not delete the log.

The parent follows you with `subagent_list`, `subagent_trace` and
`subagent_steer`, and can stop you with `subagent_cancel`. A steer arrives at
your next step: read it as a change of plan, and say so in your report.
Do not call subagent_spawn yourself.
";

fn brief(id, parent, task, minutes) {
    let text = BRIEF
        .replace("{id}", id)
        .replace("{parent}", parent)
        .replace("{deadline}", `${minutes}`)
        .replace("{cwd}", "the parent's working directory")
        .replace("{task}", task);
    text
}

// One `key=value` line per fact, in the order the state file is read by hand.
// A role and a model that were not named are empty, and the readers say so in
// their own words: this file records what was passed, not what it means.
fn meta_lines(id, parent, role, model, pid, log, status, started, minutes) {
    let lines = "";
    let facts = [
        `id=${id}`,
        `parent=${parent}`,
        `role=${role}`,
        `model=${model}`,
        `pid=${pid}`,
        `log=${log}`,
        `status=${status}`,
        `started=${started}`,
        `deadline_min=${minutes}`,
    ];
    for f in facts {
        lines += `${quote(f)} `;
    }
    lines
}

// The id between the first pair of backticks, and "" when the roster has no
// such pair: `peers` says who is registered, not whether this session is.
fn parent_id(roster) {
    let id = "";
    match roster.split_once("`") {
        Some(head) => match head.1.split_once("`") {
            Some(quoted) => id = quoted.0,
            None => {}
        },
        None => {}
    }
    id
}

// Default 15; anything the model got wrong is clamped rather than passed on,
// since the deadline is a `sleep` and 0 minutes is no child at all.
fn deadline_min(requested) {
    let n = match requested {
        Some(v) => v,
        None => 15,
    };
    if n < 1 {
        1
    } else if n > 120 {
        120
    } else {
        n
    }
}

// A field that may be absent, as the text it is: "" for a field the call did
// not carry, which reads as "not named" for every argument here.
fn text_of(value) {
    match value {
        Some(v) => `${v}`,
        None => "",
    }
}

// The roles TIERS knows, for a refusal to name them. An empty table says so in
// words rather than printing nothing.
fn known_roles() {
    let names = "";
    for k in TIERS.keys() {
        if names != "" {
            names += ", ";
        }
        names += `${k}`;
    }
    if names == "" {
        names = "(none: this file's TIERS table is empty)";
    }
    names
}

// One `key: value` line out of a rendering that has several: `shell_background`
// answers with `pid`, `log` and `status`, each on its own line.
fn field(text, key) {
    let out = "";
    let body = `${text}`;
    for line in body.split('\n') {
        if line.starts_with(`${key}: `) {
            match line.split_once(": ") {
                Some(pair) => out = pair.1,
                None => {}
            }
        }
    }
    out
}

// `shell_background` renders `status: <path> (written when the command
// finishes)`, and the parenthetical is not part of the path.
fn path_of(text) {
    let body = `${text}`;
    let out = body;
    match body.split_once(" (") {
        Some(pair) => out = pair.0,
        None => {}
    }
    out
}

// One shell word: every `'` becomes `'\''` and the whole is wrapped in `'...'`.
// The only arbitrary text here is the brief, and the only thing that reads it
// is a shell, which is what this is for.
fn quote(text) {
    let s = `${text}`;
    `'${s.replace("'", "'\\''")}'`
}
