// Every verb that reaches the service, answered by a service that is not there. The tools
// are copied from the repo unchanged; the harness only vouches for them in a temp config
// and writes the token they read, so this is the shipped bytes the test measures.
//
// What it checks: each verb names the operator's next command instead of leaving a dial
// failure to be interpreted, and none of them reports success.

pub fn workflow() {
    #{
        name: "service-down",
        description: "Check that every browser verb that reaches the service says how to start it when nothing is listening. Needs the service down (the harness refuses to run otherwise) and no live page is involved.",
        approval: "read_only",
        params: #{ "type": "object", "properties": #{} },
    }
}

pub async fn run(input) {
    let out = [];
    let bad = [];
    let want = "eidolon plugins service start browser";
    for one in calls() {
        let name = one.name;
        // `name` goes to a host primitive, which consumes it (Rune's move semantics), and
        // the answer is reported under that name — so the primitive gets a copy.
        let got = match eidolon::tool_call(name.clone(), one.args).await {
            Ok(t) => #{ ok: true, text: t },
            Err(e) => #{ ok: false, text: e },
        };
        if !got.ok && got.text.contains(want) {
            out.push("ok   " + name + " names the command that starts the service");
        } else {
            out.push("FAIL " + name + ": answered " + got.text);
            bad.push(name);
        }
    }
    let text = "";
    for l in out {
        text += l + "\n";
    }
    if bad.len() > 0 {
        return #{ content: text + "service-down: " + `${bad.len()}` + " check(s) failed", is_error: true };
    }
    text + "service-down: " + `${out.len()}` + " checks hold"
}

fn calls() {
    [
        #{ name: "browser_open", args: #{ url: "http://127.0.0.1:9/" } },
        #{ name: "browser_snapshot", args: #{} },
        #{ name: "browser_click", args: #{ "ref": "e1" } },
        #{ name: "browser_type", args: #{ "ref": "e1", text: "x" } },
        #{ name: "browser_read", args: #{} },
        #{ name: "browser_back", args: #{} },
    ]
}
