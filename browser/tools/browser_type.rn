// `browser_type`: the service's `type` (../service/src/browser.rs).
pub fn manifest() {
    #{
        name: "browser_type",
        description: "Type text into the element with this ref, taken from the most recent browser_snapshot, replacing whatever is already there. Set submit to press Enter afterward -- the common case for a search box or a single-field form. Same ref rule as browser_click: a ref not from the latest snapshot is refused by name, and this call invalidates the snapshot's refs whether or not submit is set, so follow it with browser_snapshot before using another ref.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "ref": #{
                    "type": "string",
                    "description": "A ref from the current browser_snapshot, e.g. \"e7\".",
                },
                "text": #{
                    "type": "string",
                    "description": "The text to type.",
                },
                "submit": #{
                    "type": "boolean",
                    "description": "Press Enter after typing. Default false.",
                },
            },
            "required": ["ref", "text"],
        },
    }
}

pub async fn call(input) {
    call_service("type", input).await
}

// Everything below is the same in every browser_*.rn: upstream eidolon
// compiles each tool file on its own, and a tool file is meant to be handed
// over whole.

// The browser service (../service). Change the port here and in the
// service's EIDOLON_SERVICE_PORT together.
fn service() {
    #{
        name: "browser",
        base_url: "http://127.0.0.1:8090",
        token_file: "~/.config/eidolon/browser.token",
        auth: #{ header: "Authorization", prefix: "Bearer " },
        timeout_s: 180,
    }
}

// POST {method, args} to /call; the answer is {ok, result} or {ok: false, error}.
async fn call_service(method, args) {
    let body = json::to_string(#{ "method": method, "args": args })?;
    let reply = json::from_string(eidolon::api_request(service(), "POST", "/call", Some(body)).await?)?;
    if reply.status != 200 {
        return Err(`browser service answered ${reply.status}: ${reply.body}`);
    }
    let out = json::from_string(reply.body)?;
    if out.ok { Ok(out.result) } else { Err(out.error) }
}
