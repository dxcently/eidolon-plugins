// Registers as `browser_click`. See eidolon/docs/extensions.md for the
// extension contract this rides on, and service.py's `_click` for what
// actually runs.
pub fn manifest() {
    #{
        name: "click",
        description: "Click the element with this ref, taken from the most recent browser_snapshot. A ref not from that snapshot -- reused, or from an earlier one -- is refused by name rather than guessed at. Reach for this to follow a link, press a button, or otherwise act on something browser_snapshot showed you. After it returns, call browser_snapshot again before clicking or typing anything else: this call invalidates every ref the last snapshot handed out, on the assumption that a click can change the page even when it does not navigate.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "ref": #{
                    "type": "string",
                    "description": "A ref from the current browser_snapshot, e.g. \"e7\".",
                },
            },
            "required": ["ref"],
        },
    }
}

pub async fn call(input) {
    // `input.ref` does not compile -- `ref` is a reserved word in Rune's
    // grammar (it mirrors Rust's syntax, where `ref` is a pattern-binding
    // keyword), so plain field access on it is "Unsupported field access"
    // at compile time, caught by `eidolon ext list` compiling this file
    // before it was ever run. `.get("ref")` sidesteps it: the string
    // literal is not a keyword the parser has an opinion about. A missing
    // ref falls through as "", which service.py's own `_resolve_ref`
    // already refuses by name -- see its comment -- so nothing here needs
    // to re-enforce `input_schema`'s `required`.
    let element_ref = match input.get("ref") {
        Some(r) => r,
        None => "",
    };
    eidolon::service_call("click", #{
        "ref": element_ref,
    }).await
}
