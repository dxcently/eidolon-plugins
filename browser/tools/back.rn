// Registers as `browser_back`. See eidolon/docs/extensions.md for the
// extension contract this rides on, and service.py's `_back` for what
// actually runs. Not in this extension's original five-tool brief, but
// docs/design/automation.md's wiki-hop graph calls it by this exact name
// from an EMPTY handler ("a page with nothing left to click goes back"),
// and lists it under D1's own files ("D1 adds browser_back and emits the
// two head lines from browser_snapshot") -- so it is added here rather than
// left as a graph that cannot run. Flagged in this extension's report in
// case that reading is wrong.
pub fn manifest() {
    #{
        name: "back",
        description: "Go back one entry in the shared browser's history, the way a browser's back button does. Reach for this when a page turned out to be a dead end and the previous one is still useful, or to recover after following a link that did not lead anywhere. Invalidates the current snapshot's refs like any other navigation, so follow it with browser_snapshot before using a ref.",
        approval: "read_only",
        input_schema: #{
            "type": "object",
            "properties": #{},
        },
    }
}

pub async fn call(input) {
    eidolon::service_call("back", #{}).await
}
