// browser: a Playwright-backed Chromium, shared by the whole machine, as
// `browser_open`, `browser_snapshot`, `browser_click`, `browser_type`,
// `browser_read` and `browser_back`. This is what turns the links on a page
// into the branches of a graph -- docs/design/automation.md's "choose.from:
// {refs: ...}" reads `browser_snapshot`'s output as its option list, so that
// document is this extension's contract as much as this file is.
pub fn manifest() {
    #{
        name: "browser",
        description: "Playwright/Chromium, one shared browser, as browser_open/snapshot/click/type/read/back",

        service: #{
            // `{dir}` is this extension's own directory, substituted by the
            // loader before the string reaches `bash -c`
            // (eidolon/docs/extensions.md, "extension.rn"; `command` already
            // runs under `bash -c` there, so a plain POSIX conditional does
            // the platform branch with no separate launcher script and no
            // Rune-side check). A venv's interpreter sits at a different
            // relative path on the two platforms this runs on --
            // `bin/python` on POSIX, `Scripts/python.exe` on Windows -- and
            // there is no third spelling that works on both, so this picks
            // whichever exists at start time instead of hardcoding either.
            // That is the one thing jev's manifest gets wrong
            // (extensions/jev/extension.rn:30 names one specific machine's
            // absolute path to a venv outside this repo); this extension's
            // venv is its own, at a path this loader already hands it, so
            // there is nothing left to hardcode. `-u`: unbuffered stdout, so
            // the background log (eidolon/docs/extensions.md, "When it will
            // not start") shows the real failure instead of whatever was
            // still sitting in a pipe buffer.
            command: "test -f \"{dir}/.venv/bin/python\" && \"{dir}/.venv/bin/python\" -u service.py || \"{dir}/.venv/Scripts/python.exe\" -u service.py",

            // Cheap on purpose: `service.py`'s `health()` only stats and
            // globs for the installed browser, never launches one -- see
            // its own comment for why, and the extension's report for the
            // measured cold-start this timeout is sized against.
            health: "/health",
            ready_timeout_s: 30,
        },

        tools: ["open", "snapshot", "click", "type", "read", "back"],
    }
}
